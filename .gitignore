# Add one ignore pattern per line; use # for comments, * and ? as wildcards,
# a trailing / to match directories, and ! to unignore a previously ignored path.
.venv/
__pycache__/
*.mp4
!media/captures/*.mp4

# Generated CAD output: rebuild with assets/<model>/build.py (STEP/STL are ~220 MB)
assets/*/step/
assets/*/stl/
assets/*/renders/*.png
!assets/*/renders/overview.png
assets/*/sandbox/index.html
