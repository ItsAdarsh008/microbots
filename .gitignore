# Add one ignore pattern per line; use # for comments, * and ? as wildcards,
# a trailing / to match directories, and ! to unignore a previously ignored path.
.venv/
__pycache__/
*.mp4
!media/captures/*.mp4

# Generated CAD output: rebuild with assets/<model>/build.py (STEP/STL are ~220 MB)
assets/*/step/
assets/*/stl/
assets/*/renders/*.png
!assets/*/renders/overview.png
assets/*/sandbox/index.html

# Phase 3 particle NCA: the paper authors' weights are not ours to redistribute (their repo has no licence).
# Build them locally with phase3/npa/export_web.py --fetch-paper.
*.pth
phase3/npa/web/weights/lizard_paper.js
phase3/npa/runs/
